APP_NAME="BKK Informasi Kerja"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-railway-domain.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning

# Railway PostgreSQL: set DB_CONNECTION=pgsql and map these values from the
# Railway Postgres service, or set DB_URL to the connection string.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase web configuration. These are public client settings, but still
# configure Firebase Authentication/Storage/Firestore security rules.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_API_KEY="${FIREBASE_API_KEY}"
VITE_FIREBASE_AUTH_DOMAIN="${FIREBASE_AUTH_DOMAIN}"
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_STORAGE_BUCKET="${FIREBASE_STORAGE_BUCKET}"
VITE_FIREBASE_MESSAGING_SENDER_ID="${FIREBASE_MESSAGING_SENDER_ID}"
VITE_FIREBASE_APP_ID="${FIREBASE_APP_ID}"
VITE_FIREBASE_MEASUREMENT_ID="${FIREBASE_MEASUREMENT_ID}"

# Optional server-side Firebase Admin credentials. Prefer the complete JSON
# in a Railway secret variable rather than committing a credentials file.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS=
FIREBASE_SERVER_KEY=

# Applicant CV/resume is stored as a link (Google Drive, Firebase Storage, ...),
# so no server-side object storage credentials are required.
